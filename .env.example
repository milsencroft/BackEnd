# Server-side secrets. Copy to .env.local for local work. NEVER commit real values, not even test keys.
# In production these live in Supabase: Edge Functions > Secrets (Supabase provides the SUPABASE_* ones itself).
SUPABASE_URL=https://gnnbgewcmheuhdlxhyue.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Razorpay (Dashboard > Account & Settings > API Keys). Test keys start rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string; must equal the Secret entered in the Razorpay webhook form.
RAZORPAY_WEBHOOK_SECRET=

# Optional: restrict browser calls to the website's origin (default is any origin).
ALLOWED_ORIGIN=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
